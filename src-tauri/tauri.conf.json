{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JJ PDF Studio",
  "version": "0.1.0",
  "identifier": "in.jjglobal.pdfstudio",
  "mainBinaryName": "jj-pdf-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "JJ PDF Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' blob: data:",
        "worker-src": "'self' blob:",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "JJ Global",
    "copyright": "Copyright 2026 JJ Global",
    "license": "Apache-2.0",
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
